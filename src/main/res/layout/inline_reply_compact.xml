<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="48dp" android:orientation="horizontal" android:gravity="center_vertical">
    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
        <TextView android:id="@+id/inline_reply_title" android:layout_width="match_parent" android:layout_height="wrap_content" android:maxLines="1" android:ellipsize="end" android:textStyle="bold" android:textSize="13sp" android:textColor="?android:attr/textColorPrimary" />
        <TextView android:id="@+id/inline_reply_text" android:layout_width="match_parent" android:layout_height="wrap_content" android:maxLines="1" android:ellipsize="end" android:textSize="12sp" android:textColor="?android:attr/textColorPrimary" />
    </LinearLayout>
    <TextView android:id="@+id/inline_reply_entry" android:layout_width="60dp" android:layout_height="44dp" android:layout_marginStart="6dp" android:gravity="center" android:text="回复" android:textColor="#267F80" android:textSize="14sp" android:clickable="true" android:focusable="true" android:background="?android:attr/selectableItemBackground" />
</LinearLayout>
